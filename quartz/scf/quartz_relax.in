&control
    restart_mode = 'restart',
    calculation = 'vc-relax',
    prefix      = 'quartz',
    pseudo_dir  = './pseudos',
    outdir      = './tmp',
    tstress     = .true.,
    tprnfor     = .true.,
    forc_conv_thr = 1.0d-4,
    etot_conv_thr = 1.0d-5
/
&system
    ibrav      = 0,
    nat        = 9,
    ntyp       = 2,
    ecutwfc    = 60,
    ecutrho    = 480,
    occupations= 'fixed',
    input_dft  = 'LDA'
/
&electrons
    conv_thr   = 1.0d-8,
    mixing_beta= 0.3
/
&ions
    ion_dynamics = 'bfgs'
/
&cell
    cell_dynamics = 'bfgs'
/
ATOMIC_SPECIES
 Si  28.0855  Si.pz-vbc.UPF
 O   15.9994  O.pz-van_ak.UPF

CELL_PARAMETERS angstrom
 4.9134   0.0000   0.0000
-2.4567   4.2540   0.0000
 0.0000   0.0000   5.4050

ATOMIC_POSITIONS crystal
