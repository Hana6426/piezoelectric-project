    ibrav      = 0,
    nat        = 9,
    ntyp       = 2,
    ecutwfc    = 60,
    ecutrho    = 480,
    occupations= 'fixed',
    input_dft  = 'LDA'
/
&electrons
    conv_thr   = 1.0d-8,
    mixing_beta= 0.3
/
