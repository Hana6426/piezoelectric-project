&control
  calculation = 'relax',
  prefix      = 'quartz_hex',
  outdir      = './tmp_quartz_hex',
  pseudo_dir  = './pseudos',
  tstress     = .true.,
  tprnfor     = .true.,
/
&system
  ibrav    = 0,
  nat      = 9,
  ntyp     = 2,
  ecutwfc  = 60,
  ecutrho  = 480,
  occupations = 'fixed',
  input_dft  = 'LDA',
/
&electrons
  conv_thr    = 1.0d-8,
  mixing_beta = 0.3,
/
&ions
  ion_dynamics = 'bfgs',
/
