&control
    calculation = 'scf',
    prefix      = 'quartz',
    pseudo_dir = './pseudos',
    outdir      = './tmp'
/
&system
    ibrav      = 0,
    nat        = 9,
    ntyp       = 2,
    ecutwfc    = 60,
    ecutrho    = 480,
    occupations= 'fixed',
    input_dft = 'LDA'

    lelfield = .true. .true.
    gdir = 1 1
    nppstr = 6 6
    nosym = .true. .true.
    noinv = .true. .true.
/
&electrons
    conv_thr   = 1.0d-8,
    mixing_beta= 0.3
    lberry = .true.
/
