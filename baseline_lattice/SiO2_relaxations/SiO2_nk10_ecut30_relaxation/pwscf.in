&CONTROL
    calculation = 'vc-relax'
    pseudo_dir = '/home/bond/Software/QE/qe-7.4.1/pseudo'
    outdir = '/home/bond/piezoelectric-project/baseline_lattice/SiO2_relaxations/SiO2_nk10_ecut30_relaxation'
    tstress = .true.
    tprnfor = .true.
    disk_io = 'none'
/ 
&SYSTEM
    ecutwfc = 30
    ecutrho = 240
    input_dft = 'LDA'
    ntyp = 2
    nat = 9
    ibrav = 0
/ 
&ELECTRONS
    diagonalization = 'david'
    mixing_beta = 0.7
    conv_thr = 1e-07
/ 
&IONS
    ion_dynamics = 'bfgs'
/ 
&CELL
/ 
K_POINTS {automatic}
 10 10 10  1 1 1
