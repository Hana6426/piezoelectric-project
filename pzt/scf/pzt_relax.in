&control
  calculation = 'vc-relax',
  prefix      = 'pzt',
  outdir      = './tmp_pzt',
  pseudo_dir  = './pseudos',
  tstress     = .true.,
  tprnfor     = .true.
/
&system
  ibrav    = 0,
  nat      = 5,
  ntyp     = 3,
  ecutwfc  = 60,
  ecutrho  = 480,
  occupations = 'fixed',
  input_dft  = 'LDA'
/
&electrons
  conv_thr    = 1.0d-8,
  mixing_beta = 0.3
/
&ions
  ion_dynamics = 'bfgs'
/
&cell
  cell_dynamics = 'bfgs'
/
ATOMIC_SPECIES
  Pb  207.2   Pb.pz-d-van.UPF
  Ti   47.867  Ti.pz-sp-van_ak.UPF
  O    15.999  O.pz-van_ak.UPF

CELL_PARAMETERS angstrom
  3.90  0.00  0.00
  0.00  3.90  0.00
  0.00  0.00  4.10

# P4mm (tetragonal) starting positions (scaled)
ATOMIC_POSITIONS crystal
  Pb  0.0000  0.0000  0.0000
  Ti  0.5000  0.5000  0.5400
  O   0.5000  0.5000  0.1000
  O   0.5000  0.0000  0.6000
  O   0.0000  0.5000  0.6000

K_POINTS automatic
  6 6 6  0 0 0
