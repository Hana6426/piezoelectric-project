&CONTROL
    calculation = 'scf'
    pseudo_dir = '/home/bond/Software/QE/qe-7.4.1/pseudo'
    outdir = '/home/bond/piezoelectric-project/pzt/dfpt/PbTiO3_scf'
    tstress = .true.
    tprnfor = .true.
/ 
&SYSTEM
    ecutwfc = 60
    ecutrho = 480
    input_dft = 'LDA'
    ntyp = 3
    nat = 5
    ibrav = 0
/ 
&ELECTRONS
    diagonalization = 'david'
    mixing_beta = 0.7
    conv_thr = 1e-07
/ 
&IONS
    ion_dynamics = 'bfgs'
/ 
&CELL
/ 
