&control
  calculation = 'scf',
  prefix      = 'pzt_e33_p0.005',
  outdir      = './tmp_pzt_e33_p0.005',
  pseudo_dir  = './pseudos'
  ! NOTE: if your Berry-phase example had extra keywords in &control,
  ! copy them here (e.g. tefield/lelfield stuff from class template).
/
&system
  ibrav    = 0,
  nat      = 5,
  ntyp     = 3,
  ecutwfc  = 60,
  ecutrho  = 480,
  occupations = 'fixed',
  input_dft  = 'LDA'
  ! >>> IMPORTANT: Insert the SAME Berry-phase flags used in your class example
  ! For instance, things like:
  ! lberry = .true.
  ! gdir   = 3
  ! nppstr = 8
  ! ...OR the equivalent 'lelfield' settings, exactly as given by the instructor.
/
&electrons
  conv_thr    = 1.0d-8,
  mixing_beta = 0.3
/
