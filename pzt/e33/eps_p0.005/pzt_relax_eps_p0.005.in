&control
  calculation = 'relax',
  prefix      = 'pzt_e33_p0.005',
  outdir      = './tmp_pzt_e33_p0.005',
  pseudo_dir  = './pseudos',
  tstress     = .true.,
  tprnfor     = .true.
/
&system
  ibrav    = 0,
  nat      = 5,
  ntyp     = 3,
  ecutwfc  = 60,
  ecutrho  = 480,
  occupations = 'fixed',
  input_dft  = 'LDA'
/
&electrons
  conv_thr    = 1.0d-8,
  mixing_beta = 0.3
/
&ions
  ion_dynamics = 'bfgs'
/
